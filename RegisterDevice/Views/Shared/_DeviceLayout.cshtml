@* _DeviceLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RegisterDevice</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <!-- top navbar here -->
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
            }
            <div class="col-md-3 col-lg-2 px-0 sidebar bg-light min-vh-100">
                <nav class="nav flex-column pt-3">
                    <a class="nav-link @(controller == "Device" && action == "Index" ? "active" : "")" asp-controller="Device" asp-action="Index">
                        <i class="bi bi-laptop me-2"></i>My Devices
                    </a>
                    <a class="nav-link @(controller == "Device" && action == "RegisterDevice" ? "active" : "")" asp-controller="Device" asp-action="RegisterDevice">
                        <i class="bi bi-plus-circle me-2"></i>Register Device
                    </a>
                    <a class="nav-link @(controller == "Public" && action == "CheckDevice" ? "active" : "")" asp-controller="Public" asp-action="CheckDevice">
                        <i class="bi bi-search me-2"></i>Check Device
                    </a>
                </nav>
            </div>

            <!-- Main content -->
            <div class="col-md-9 col-lg-10 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted py-2">
        <div class="container">
            &copy; 2026 - RegisterDevice - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
