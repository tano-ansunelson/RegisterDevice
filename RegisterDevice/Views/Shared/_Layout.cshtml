<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Register Device</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RegisterDevice.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- LEFT -->
                <span class="navbar-brand fw-semibold mb-0">
                    My Devices
                </span>

                <!-- RIGHT -->
                <div class="d-flex align-items-center gap-2 ms-auto">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="text-muted me-2">
                            Welcome, <strong>@User.Identity.Name</strong>
                        </span>

                        <button class="btn btn-outline-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#logoutModal">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm"
                           asp-controller="Home"
                           asp-action="LandingPage">
                            Home
                        </a>

                        <a class="btn btn-outline-primary btn-sm"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>

                       
                    }

                </div>

            </div>
        </nav>

        @RenderSection("Styles", required: false)
    </header>



