<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RegisterDevice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RegisterDevice.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                @if (Context.Session.GetString("IsAdmin") == "true")
                {
                    <!-- ADMIN Navbar -->
                    <span class="navbar-brand fw-semibold mb-0">
                        Admin Panel
                    </span>
                    <span class="text-muted">
                        Welcome, <strong>Admin</strong>
                    </span>
                    <a class="btn btn-outline-danger btn-sm"
                       asp-controller="Admin"
                       asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </a>
                }
                else if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- USER Navbar -->
                    <span class="navbar-brand fw-semibold mb-0">
                        My Devices
                    </span>
                    <span class="text-muted">
                        Welcome, <strong>@User.Identity.Name</strong>
                    </span>
                    <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal"
                            data-bs-target="#logoutModal">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                }
                else
                {
                    <span class="navbar-brand fw-semibold mb-0">
                        My Devices
                    </span>

                    <div class="ms-auto d-flex align-items-center gap-2">
                      

                        @if (Context.Request.Path == "/Account/Login")
                        {
                            <!-- Home link always visible for guests -->
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Home"
                               asp-action="LandingPage">
                                Home
                            </a>

                            <!-- On Login page: show Register link -->
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        }
                        else if (Context.Request.Path == "/Account/Register")
                        {

                            <!-- Home link always visible for guests -->
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Home"
                               asp-action="LandingPage">
                                Home
                            </a>

                            <!-- On Register page: show Login link -->
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        }
                        else if (Context.Request.Path == "/Admin/Login")
                        {
                            <!-- Home link always visible for guests -->
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Home"
                               asp-action="LandingPage">
                                Home
                            </a>
                        }

                        else
                        {
                            <!-- On all other guest pages: show both -->
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                            <a class="nav-link text-dark fw-semibold px-2 rounded hover-link"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        }
                    </div>
                }

            </div>
        </nav>
        @RenderSection("Styles", required: false)
    </header>


 

    <div class="container">
        <partial name="_LogoutModal"/>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RegisterDevice - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
