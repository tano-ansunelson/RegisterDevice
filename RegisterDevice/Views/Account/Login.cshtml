
@model RegisterDevice.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
   
}

@section Styles {
    <style>
        .login-page {
            background-color: #f8f9fa;
            min-height: calc(100vh - 56px); /* navbar height */
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-card {
            max-width: 450px;
            width: 100%;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
}

<div class="login-page">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-primary" style="font-size: 2.5rem;"></i>
                <h1 class="h3 mt-3">Login</h1>
                <p class="text-muted">Access your device registry account</p>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">Email or Username</label>
                    <input asp-for="Login" type="text" class="form-control" required />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>

                    <div class="input-group">
                        <input asp-for="Password"
                               id="studentPassword"
                               type="password"
                               class="form-control"
                               required />

                        <span class="input-group-text"
                              style="cursor:pointer"
                              onclick="togglePassword('studentPassword','studentEye')">
                            <i class="bi bi-eye" id="studentEye"></i>
                        </span>
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="form-text">Must be at least 8 characters long</div>
                </div>


                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input">
                    <label class="form-check-label">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3" id="loginBtn">
                    <span class="btn-text">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </span>
                  

                     <span class="spinner-border spinner-border-sm d-none"
                          role="status"
                          aria-hidden="true"
                          id="loginSpinner">
                    </span>
                </button>

                <div class="text-center">
                    <a href="#" class="small">Forgot password?</a>
                </div>
            </form>

            <hr>

            <div class="text-center">
                <p class="text-muted small mb-2">Don't have an account?</p>
                <a asp-action="Register" class="btn btn-outline-secondary w-100">
                    Create Account
                </a>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.querySelector("form");
        const btnText = document.querySelector(".btn-text");
        const spinner = document.getElementById("loginSpinner");
        const button = document.getElementById("loginBtn");

        if (!form) return; // safety check

        form.addEventListener("submit", function () {
            btnText.classList.add("d-none");
            spinner.classList.remove("d-none");
            button.disabled = true;
        });

    });

    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    }
</script>

