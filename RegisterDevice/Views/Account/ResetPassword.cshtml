@model RegisterDevice.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Reset Password</h4>

                    <form asp-action="ResetPassword" method="post">

                        <input asp-for="Token" type="hidden" />
                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <div
                                class="input-group input-group-sm">
                                <input asp-for="Password" class="form-control form-control-sm" type="password"
                                id="studentPassword"
                                required
                                />
                                <span class="input-group-text" style="cursor:pointer"
                                onclick="togglePassword('studentPassword','studentEye')"
                                >
                                <i class="bi bi-eye" id="studentEye"></i>

                                </span>
                            </div>

                           
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="input-group input-group-sm">
                                <input asp-for="ConfirmPassword" class="form-control form-control-sm" type="password" id="studentPassword" required />

                                <span class="input-group-text" style="cursor:pointer"
                                      onclick="togglePassword('studentPassword','studentEye')">
                                    <i class="bi bi-eye" id="studentEye"></i>

                                </span>
                            </div>

                           
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>


                        <button type="submit" class="btn btn-dark w-100">
                            Reset Password
                        </button>

                        <span class="text-danger mt-2 d-block">
                            @Html.ValidationSummary()
                        </span>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

     function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    }
</script>