@{
    ViewData["Title"] = "Check Email";
}

<div class="container py-5 text-center">
    <h4>Password Reset</h4>

    @if (TempData["ResetLink"] != null)
    {
        <p class="mt-3">
            Demo Reset Link:
            <a href="@TempData["ResetLink"]">
                @TempData["ResetLink"]
            </a>
        </p>
    }
    else
    {
        <p>If your email exists, a reset link has been sent.</p>
    }

    <a asp-action="Login" class="btn btn-dark mt-3">Back to Login</a>
</div>