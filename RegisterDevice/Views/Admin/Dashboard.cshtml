@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
        </h2>
        <div class="text-muted">
            <small>Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</small>
        </div>
    </div>

    <!-- STATS CARDS -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Users</p>
                            <h2 class="fw-bold mb-0">@Model.TotalUser.ToString("N0")</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-success">
                            <i class="bi bi-arrow-up-short"></i>
                            <span class="fw-semibold">Active users</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Devices</p>
                            <h2 class="fw-bold mb-0">@Model.TotalDevices.ToString("N0")</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-phone-fill text-success fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-check-circle-fill"></i>
                            <span class="fw-semibold">Registered devices</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Lost Devices</p>
                            <h2 class="fw-bold mb-0 text-danger">@Model.TotalLostReports.ToString("N0")</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-danger">
                            <i class="bi bi-shield-exclamation"></i>
                            <span class="fw-semibold">Requires attention</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLES ROW -->
    <div class="row g-4">
        <!-- LOST DEVICES -->
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-exclamation-circle-fill text-danger me-2"></i>
                            Recent Lost Devices
                        </h5>
                        <span class="badge bg-danger rounded-pill">@Model.RecentLostDevices.Count()</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 text-muted fw-semibold ps-4" style="font-size: 0.875rem;">Brand</th>
                                    <th class="border-0 text-muted fw-semibold" style="font-size: 0.875rem;">Model</th>
                                    <th class="border-0 text-muted fw-semibold" style="font-size: 0.875rem;">IMEI</th>
                                    <th class="border-0 text-muted fw-semibold pe-4" style="font-size: 0.875rem;">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.RecentLostDevices)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-semibold">@d.Brand</span>
                                        </td>
                                        <td class="text-muted">@d.Model</td>
                                        <td>
                                            <code class="bg-light px-2 py-1 rounded">@(d.Identifier.Substring(0, 6))•••••</code>
                                        </td>
                                        <td class="pe-4">
                                            <small class="text-muted">
                                                <i class="bi bi-calendar3 me-1"></i>@d.ReportedAt.ToShortDateString()
                                            </small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <a href="#" class="btn btn-sm btn-outline-danger">
                        View All Lost Devices
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- REGISTERED DEVICES -->
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-phone-fill text-primary me-2"></i>
                            Recently Registered Devices
                        </h5>
                        <span class="badge bg-primary rounded-pill">@Model.RecentDevies.Count()</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 text-muted fw-semibold ps-4" style="font-size: 0.875rem;">Brand</th>
                                    <th class="border-0 text-muted fw-semibold" style="font-size: 0.875rem;">Model</th>
                                    <th class="border-0 text-muted fw-semibold pe-4" style="font-size: 0.875rem;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.RecentDevies)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-semibold">@d.Brand</span>
                                        </td>
                                        <td class="text-muted">@d.Model</td>
                                        <td class="pe-4">
                                            @if (d.Status == "Lost")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger">
                                                    <i class="bi bi-exclamation-circle-fill me-1"></i>@d.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success">
                                                    <i class="bi bi-check-circle-fill me-1"></i>@d.Status
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <a href="#" class="btn btn-sm btn-outline-primary">
                        View All Devices
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- USERS -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-person-badge-fill text-dark me-2"></i>
                            Recently Registered Users
                        </h5>
                        <span class="badge bg-dark rounded-pill">@Model.RecentUser.Count()</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 text-muted fw-semibold ps-4" style="font-size: 0.875rem;">
                                        <i class="bi bi-person me-1"></i>Full Name
                                    </th>
                                    <th class="border-0 text-muted fw-semibold pe-4" style="font-size: 0.875rem;">
                                        <i class="bi bi-envelope me-1"></i>Email
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.RecentUser)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                    <span class="text-primary fw-bold">@u.FullName.Substring(0, 1).ToUpper()</span>
                                                </div>
                                                <span class="fw-semibold">@u.FullName</span>
                                            </div>
                                        </td>
                                        <td class="pe-4">
                                            <a href="mailto:@u.Email" class="text-decoration-none text-muted">
                                                @u.Email
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center py-3">
                    <a href="#" class="btn btn-sm btn-outline-dark">
                        View All Users
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
