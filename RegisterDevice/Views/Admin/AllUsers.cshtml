@model List<AdminUserViewModel>

@{
    ViewData["Title"] = "All Users";
   }

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap');

    .page-root {
        font-family: 'DM Sans', sans-serif;
        background: #f5f4f0;
        min-height: 100vh;
        padding: 2.5rem 0 4rem;
    }

    .page-eyebrow {
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #9e9b94;
        margin-bottom: 0.3rem;
    }

    .page-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 2rem;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.15;
        margin: 0;
    }

    .back-link {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b6860;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: color 0.2s;
    }

        .back-link:hover {
            color: #1a1a1a;
        }

    /* ── Stats pills ── */
    .stats-strip {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #fff;
        border: 1px solid #e2e0d8;
        border-radius: 2px;
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
        color: #6b6860;
    }

        .stat-pill strong {
            color: #1a1a1a;
            font-size: 1rem;
        }

    /* ── Filter Bar ── */
    .filter-bar {
        background: #fff;
        border: 1px solid #e2e0d8;
        border-radius: 2px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

        .filter-bar .search-wrap {
            position: relative;
            flex: 1;
            min-width: 180px;
        }

            .filter-bar .search-wrap i {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: #9e9b94;
                font-size: 0.9rem;
            }

        .filter-bar input[type="text"] {
            padding-left: 2.1rem;
            border: 1px solid #dbd9d2;
            border-radius: 2px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            color: #1a1a1a;
            background: #fafaf8;
            width: 100%;
            height: 38px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .filter-bar input[type="text"]:focus {
                outline: none;
                border-color: #212529;
                box-shadow: 0 0 0 3px rgba(33,37,41,0.07);
                background: #fff;
            }

    .count-tag {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #9e9b94;
        white-space: nowrap;
    }

    /* ── Data Card ── */
    .data-card {
        background: #fff;
        border: 1px solid #e2e0d8;
        border-radius: 2px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 16px rgba(0,0,0,0.05);
    }

        .data-card::before {
            content: '';
            display: block;
            height: 3px;
            background: #212529;
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .data-table thead tr {
            border-bottom: 1px solid #eceae4;
        }

        .data-table thead th {
            padding: 0.9rem 1.1rem;
            font-size: 0.68rem;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #9e9b94;
            background: #fafaf8;
            white-space: nowrap;
        }

            .data-table thead th:first-child {
                padding-left: 1.5rem;
            }

            .data-table thead th:last-child {
                padding-right: 1.5rem;
            }

        .data-table tbody tr {
            border-bottom: 1px solid #f0ede8;
            transition: background 0.15s;
        }

            .data-table tbody tr:last-child {
                border-bottom: none;
            }

            .data-table tbody tr:hover {
                background: #fafaf8;
            }

        .data-table tbody td {
            padding: 1rem 1.1rem;
            color: #3a3835;
            vertical-align: middle;
        }

            .data-table tbody td:first-child {
                padding-left: 1.5rem;
            }

            .data-table tbody td:last-child {
                padding-right: 1.5rem;
            }

    /* ── Avatar ── */
    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
        flex-shrink: 0;
        margin-right: 0.75rem;
        border: 1px solid #e2e0d8;
        font-family: 'Playfair Display', Georgia, serif;
        color: #fff;
        background: #212529;
    }

    /* cycling soft colors per letter initial */
    .avatar-a {
        background: #264653;
    }

    .avatar-b {
        background: #2a9d8f;
    }

    .avatar-c {
        background: #e9c46a;
        color: #1a1a1a;
    }

    .avatar-d {
        background: #f4a261;
        color: #1a1a1a;
    }

    .avatar-e {
        background: #e76f51;
    }

    .avatar-f {
        background: #457b9d;
    }

    .avatar-g {
        background: #6d6875;
    }

    .avatar-default {
        background: #212529;
    }

    .user-name {
        font-weight: 500;
        color: #1a1a1a;
        line-height: 1.2;
    }

    .user-email-link {
        font-size: 0.82rem;
        color: #9e9b94;
        text-decoration: none;
        transition: color 0.2s;
    }

        .user-email-link:hover {
            color: #1a1a1a;
        }

    .email-full {
        font-size: 0.9rem;
        color: #6b6860;
        text-decoration: none;
        transition: color 0.2s;
    }

        .email-full:hover {
            color: #1a1a1a;
        }

    .date-cell {
        font-size: 0.82rem;
        color: #9e9b94;
        white-space: nowrap;
    }

    .row-index {
        font-size: 0.75rem;
        color: #c2bfb8;
        font-weight: 400;
        min-width: 2rem;
    }

    .device-count {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.78rem;
        background: #f0ede8;
        color: #6b6860;
        border-radius: 2px;
        padding: 0.2rem 0.55rem;
    }

    /* ── Table Footer ── */
    .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-top: 1px solid #eceae4;
        background: #fafaf8;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .footer-info {
        font-size: 0.78rem;
        color: #9e9b94;
    }

    .pager {
        display: flex;
        gap: 0.3rem;
    }

        .pager a, .pager span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            font-size: 0.78rem;
            font-weight: 500;
            border: 1px solid #dbd9d2;
            border-radius: 2px;
            text-decoration: none;
            color: #6b6860;
            background: #fff;
            transition: all 0.15s;
        }

            .pager a:hover {
                background: #f0ede8;
                border-color: #c2bfb8;
                color: #1a1a1a;
            }

            .pager span.active {
                background: #212529;
                border-color: #212529;
                color: #fff;
            }

    /* Empty */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #9e9b94;
    }

        .empty-state i {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            opacity: 0.4;
        }

        .empty-state p {
            font-size: 0.9rem;
            margin: 0;
        }
</style>

<div class="page-root">
    <div class="container-fluid px-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
            <div>
                <p class="page-eyebrow">Directory · Accounts</p>
                <h1 class="page-title">All Users</h1>
            </div>
            <a asp-controller="Admin" asp-action="Dashboard" class="back-link">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>

        <!-- Stats Strip -->
        <div class="stats-strip">
            <div class="stat-pill">
                <i class="bi bi-people"></i>
                <span>Total Users <strong>@Model.Count()</strong></span>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="searchInput" placeholder="Search by name or email…" oninput="filterTable()" />
            </div>
            <span class="count-tag" id="countTag">@Model.Count() records</span>
        </div>

        <!-- Table Card -->
        <div class="data-card">
            <div class="table-responsive">
                <table class="data-table" id="mainTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Devices</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int idx = 1;
                        }
                        @foreach (var u in Model)
                        {
                            var initial = u.FullName.Substring(0, 1).ToLower();
                            var avatarColors = new[] { "a", "b", "c", "d", "e", "f", "g" };
                            var colorClass = "avatar-" + (avatarColors.Contains(initial) ? initial : "default");

                            <tr>
                                <td class="row-index">@idx</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="user-avatar @colorClass">
                                            @u.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="user-name">@u.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@u.Email" class="email-full">
                                        <i class="bi bi-envelope me-1" style="font-size:0.8rem;color:#c2bfb8;"></i>@u.Email
                                    </a>
                                </td>
                                <td>
                                    <span class="device-count">
                                        <i class="bi bi-phone"></i> @u.DeviceCount
                                    </span>
                                </td>
                                <td class="date-cell">
                                    <i class="bi bi-calendar3 me-1"></i>@u.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-people"></i>
                        <p>No users registered yet.</p>
                    </div>
                }
            </div>
            <div class="table-footer">
                <span class="footer-info" id="footerCount">Showing @Model.Count() of @Model.Count() results</span>
                <div class="pager">
                    <a href="#"><i class="bi bi-chevron-left" style="font-size:0.7rem"></i></a>
                    <span class="active">1</span>
                    <a href="#"><i class="bi bi-chevron-right" style="font-size:0.7rem"></i></a>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const rows   = document.querySelectorAll('#mainTable tbody tr');
        let visible  = 0;

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (text.includes(search)) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('countTag').innerText = visible + ' records';
        document.getElementById('footerCount').innerText = 'Showing ' + visible + ' of ' + rows.length + ' results';
    }
</script>
