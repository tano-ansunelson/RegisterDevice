
@{
    ViewData["Title"] = "Check Device";
}

@section Styles {
    <style>
        .check-page {
            min-height: calc(100vh - 56px);
            background-color: #f8f9fa;
            padding: 20px;
        }

        .check-card {
            max-width: 420px;
            width: 100%;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            background-color: #ffffff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
        }

            .sidebar .nav-link {
                color: #495057;
                padding: 0.875rem 1.25rem;
                border-left: 3px solid transparent;
            }

                .sidebar .nav-link.active {
                    color: #0d6efd;
                    background-color: #e7f1ff;
                    border-left-color: #0d6efd;
                }

        @@media (max-width: 767.98px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                width: 100% !important;
                margin: 0 !important;
                padding-top: 1rem !important;
            }
        }

        @@media (max-width: 767.98px) {
            .layout-wrapper,
            .container-fluid {
                min-height: auto !important;
            }
        }
    </style>
}

<div class="check-page container-fluid">
   @*  <div class="row"> *@

        <!-- Sidebar -->
       @*  <div class="offcanvas-md offcanvas-start sidebar col-md-3 col-lg-2 px-0"
             tabindex="-1"
             id="sidebarMenu">

            <nav class="nav flex-column pt-3">
                <a class="nav-link"  asp-controller="Home" asp-action="Index">
                    <i class="bi bi-laptop me-2"></i>My Devices
                </a>

                <a class="nav-link" asp-controller="Home" asp-action="RegisterDevice">
                    <i class="bi bi-plus-circle me-2"></i>Register Device
                </a>

                <a class="nav-link active" data-bs-dismiss="offcanvas" asp-controller="Public" asp-action="CheckDevice">
                    <i class="bi bi-search me-2"></i>Check Device
                </a>
            </nav>
        </div> *@

        <!-- Main content -->
        <div class="col-md-9 col-lg-10">

            <!-- Mobile sidebar toggle ONLY -->
            <div class="d-md-none mb-3">
                <button class="btn btn-outline-primary"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#sidebarMenu">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <!-- Card (VISIBLE ON ALL SCREENS) -->
            <div class="card check-card shadow-sm mt-4 mx-auto">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <i class="bi bi-search text-primary" style="font-size: 2.5rem;"></i>
                        <h5 class="mt-3">Check Device Status</h5>
                        <p class="text-muted small">
                            Enter the IMEI number to check device information
                        </p>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">IMEI Number</label>
                            <input type="text"
                                   name="identifier"
                                   class="form-control mb-3"
                                   placeholder="Enter 15-digit IMEI"
                                   maxlength="15" />
                            <div class="form-text">
                                Dial <strong>*#06#</strong> on the phone to find IMEI
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Search
                        </button>
                    </form>

                    @if (ViewBag.NotFound == true)
                    {
                      <div class="alert alert-success mt-3">

                          No lost record found for this device.
                      </div>
                    }
                    @foreach( var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        
                        <div class="alert alert-danger mt-3">
                            @error.ErrorMessage
                        </div>
                    }

                </div>
            </div>

        </div>




 @*    </div> *@
</div>
