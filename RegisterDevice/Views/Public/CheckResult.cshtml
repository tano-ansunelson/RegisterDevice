@model RegisterDevice.Models.LostDeviceReport
@{
    ViewData["Title"] = "Device Found";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-lg">

                <!-- Card Header -->
                <div class="card-header bg-white text-dark border-bottom border-2 p-4">
                    <div class="text-center">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 2.5rem;"></i>
                        </div>
                        <h3 class="fw-bold mb-2 text-dark">Device Reported as Lost</h3>
                        <p class="mb-0 text-muted">This device has been flagged in our system</p>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">

                    <!-- Device Information -->
                    <h5 class="fw-bold mb-4 text-dark">
                        <i class="bi bi-info-circle-fill me-2 text-primary"></i>Device Information
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1 fw-medium">
                                    <i class="bi bi-building me-1"></i>Brand
                                </small>
                                <span class="fw-semibold fs-5 text-dark">@Model.Brand</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1 fw-medium">
                                    <i class="bi bi-phone me-1"></i>Model
                                </small>
                                <span class="fw-semibold fs-5 text-dark">@Model.Model</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1 fw-medium">
                                    <i class="bi bi-hash me-1"></i>IMEI / Serial Number
                                </small>
                                <code class="fs-5 fw-bold text-dark bg-white px-2 py-1 rounded">@Model.Identifier</code>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1 fw-medium">
                                    <i class="bi bi-calendar-x me-1"></i>Reported On
                                </small>
                                <span class="fw-semibold text-dark">@Model.ReportedAt.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted d-block mb-1 fw-medium">
                                    <i class="bi bi-exclamation-circle me-1"></i>Status
                                </small>
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6 fw-semibold">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Lost/Stolen
                                </span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Warning Alert -->
                    <div class="alert alert-light border border-warning border-2 shadow-sm">
                        <div class="d-flex align-items-start">
                            <div class="bg-warning bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-2 text-dark">⚠️ Important Notice</h6>
                                <p class="mb-0 text-dark">
                                    If you found this device, please return it to the nearest police station or contact the rightful owner. Possessing lost or stolen property may be illegal.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="CheckDevice" class="btn btn-dark btn-lg">
                            <i class="bi bi-search me-2"></i>Search Another Device
                        </a>
                        <a asp-controller="Public" asp-action="CheckDevice" class="btn btn-outline-dark btn-lg">
                            <i class="bi bi-house me-2"></i>Back to Home
                        </a>
                    </div>

                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light border-top text-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Help us fight device theft - Always verify before purchasing
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>













