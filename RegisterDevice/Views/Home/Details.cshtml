@{
    ViewData["Title"] = "Device Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-phone me-2"></i>Device Information
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold">IMEI</div>
                        <div class="col-sm-8">356938035643809</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold">Brand</div>
                        <div class="col-sm-8">Samsung</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold">Model</div>
                        <div class="col-sm-8">Galaxy S21</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold">Device Type</div>
                        <div class="col-sm-8">Smartphone</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold">Status</div>
                        <div class="col-sm-8">
                            <span class="badge bg-success">Safe</span>
                            <!-- change to bg-danger for lost -->
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold">Owner</div>
                        <div class="col-sm-8">John Doe</div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4 fw-semibold">Registered On</div>
                        <div class="col-sm-8">12 Jan 2026</div>
                    </div>

                </div>

                <div class="card-footer text-end">
                    <a asp-action="Check" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>

                    <span class="ms-3 text-success fw-semibold">
                        ✔ Device is safe
                    </span>
                </div>

            </div>

        </div>
    </div>
</div>
