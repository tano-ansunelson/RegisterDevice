@model RegisterDevice.Models.RegisteredDevice


@{
    // Layout = "~/Views/Shared/_DeviceLayout.cshtml";
    ViewData["Title"] = "Register Device";

}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-start">
            <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-exclamation-triangle-fill text-danger"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-2">Please fix the following errors:</h6>
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            background-color: #ffffff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
        }

            .sidebar .nav-link {
                color: #495057;
                padding: 0.875rem 1.25rem;
                border-left: 3px solid transparent;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover {
                    background-color: #f8f9fa;
                    color: #0d6efd;
                }

                .sidebar .nav-link.active {
                    color: #0d6efd;
                    background-color: #e7f1ff;
                    border-left-color: #0d6efd;
                }

        .main-content {
            padding: 2rem;
        }

        .form-card {
            max-width: 700px;
        }

        @@media (max-width: 767.98px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                width: 100% !important;
                margin: 0 !important;
                padding-top: 1rem !important;
            }
        }

        @@media (max-width: 767.98px) {
            .layout-wrapper,
            .container-fluid {
                min-height: auto !important;
            }
        }
    </style>
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="offcanvas-md offcanvas-start sidebar col-md-3 col-lg-2 px-0"
             tabindex="-1"
             id="sidebarMenu">

            <div class="offcanvas-header d-md-none border-bottom">
                <h5 class="offcanvas-title">Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu"></button>
            </div>

            <nav class="nav flex-column pt-3">
                <a class="nav-link " asp-controller="Home" asp-action="Index">
                    <i class="bi bi-laptop me-2"></i>My Devices
                </a>

                <a class="nav-link active" asp-controller="Home" asp-action="RegisterDevice">
                    <i class="bi bi-plus-circle me-2"></i>Register Device
                </a>

                <a class="nav-link" asp-controller="Home" asp-action="Profile">
                    <i class="bi bi-search me-2"></i>Profile
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 main-content">

            <!-- Header -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <button class="btn btn-outline-secondary d-md-none"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#sidebarMenu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h1 class="h3 mb-1 fw-bold">
                            <i class="bi bi-plus-circle-fill text-primary me-2"></i>
                            Register New Device
                        </h1>
                        <p class="text-muted mb-0">Add a device to your registry for protection</p>
                    </div>
                </div>
            </div>

            <!-- Progress Indicator -->
            <div class="form-card mx-auto mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white me-2" style="width: 30px; height: 30px;">
                                    <small class="fw-bold">1</small>
                                </div>
                                <small class="fw-semibold">Device Info</small>
                            </div>
                            <div class="flex-grow-1 mx-3">
                                <div class="progress" style="height: 3px;">
                                    <div class="progress-bar bg-primary" style="width: 50%"></div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-muted me-2" style="width: 30px; height: 30px;">
                                    <small class="fw-bold">2</small>
                                </div>
                                <small class="text-muted">Complete</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm form-card mx-auto">

                <div class="card-body p-4">

                    <!--Form Part of Registering-->

                    <form asp-action="RegisterDevice" asp-controller="Home" method="post" enctype="multipart/form-data">

                        <!-- Device Type -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-tag-fill text-primary me-2"></i>
                                Device Type <span class="text-danger">*</span>
                            </label>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <input class="btn-check"
                                           type="radio"
                                           name="DeviceType"
                                           id="devicePhone"
                                           value="Phone"
                                           checked>
                                    <label class="btn btn-outline-primary w-100 py-3" for="devicePhone">
                                        <i class="bi bi-phone fs-4 d-block mb-2"></i>
                                        <span class="fw-semibold">Mobile Phone</span>
                                    </label>
                                </div>
                                <div class="col-sm-6">
                                    <input class="btn-check"
                                           type="radio"
                                           name="DeviceType"
                                           id="deviceLaptop"
                                           value="Laptop">
                                    <label class="btn btn-outline-primary w-100 py-3" for="deviceLaptop">
                                        <i class="bi bi-laptop fs-4 d-block mb-2"></i>
                                        <span class="fw-semibold">Laptop</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Brand & Model -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-building text-primary me-2"></i>
                                    Brand <span class="text-danger">*</span>
                                </label>
                                <select class="form-select form-select-lg" asp-for="Brand" id="brandSelect" name="Brand" required>
                                    <!-- Options will be injected by JS -->
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-phone text-primary me-2"></i>
                                    Model <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Model" type="text" class="form-select-lg form-control" placeholder="e.g. iPhone 14 Pro / ProBook 450 G9" required />
                            </div>
                        </div>

                        <!-- IMEI / Serial -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-hash text-primary me-2"></i>
                                IMEI / Serial Number <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Identifier" type="text" class="form-select-lg form-control" placeholder="Enter IMEI or serial number" required />
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>Tip:</strong> Dial <code class="bg-light px-2 py-1 rounded">*#06#</code> to get your phone's IMEI number.
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Device Images -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-images text-primary me-2"></i>
                                Device Images
                                <span class="text-danger">*</span>
                            </label>

                            <div class="border border-2 border-dashed rounded p-4 text-center bg-light">
                                <i class="bi bi-cloud-upload text-primary fs-1 mb-3 d-block"></i>
                                <input type="file"
                                       name="DeviceImages"
                                       class="form-control"
                                       accept="image/*"
                                       multiple
                                       required
                                       id="deviceImageInput" />
                                <p class="text-muted mt-2 mb-0">
                                    <small>Upload clear images of the device (front, back, box). Maximum 5 images.</small>
                                </p>
                            </div>

                            <!-- Image Preview -->
                            <div id="imagePreview" class="d-flex flex-wrap mt-3 gap-2"></div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-journal-text text-primary me-2"></i>
                                Additional Notes
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Add any additional details about your device..."></textarea>
                            <div class="form-text">
                                <small>Optional: Include identifying marks, scratches, or unique features.</small>
                            </div>
                        </div>

                        <!-- Warning -->
                        <div class="alert alert-warning border-0 shadow-sm">
                            <div class="d-flex align-items-start">
                                <div class="bg-warning bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Important Reminder</h6>
                                    <p class="mb-0 small">Ensure the IMEI or serial number is correct. This information cannot be changed after registration.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-x-lg me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-check-lg me-2"></i>Register Device
                            </button>
                        </div>

                    </form>

                </div>
            </div>

            <!-- Help Section -->
            <div class="form-card mx-auto mt-4">
                <div class="alert alert-info border-0 shadow-sm">
                    <div class="d-flex align-items-start">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                            <i class="bi bi-info-circle-fill text-info"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Why Register Your Device?</h6>
                            <ul class="mb-0 small ps-3">
                                <li>Protect your device from theft and loss</li>
                                <li>Increase chances of recovery if lost or stolen</li>
                                <li>Create a verified ownership record</li>
                                <li>Help others identify stolen devices before purchasing</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    const phoneBrands = [
        "Apple",
        "Samsung",
        "Google",
        "Xiaomi",
        "Huawei",
        "Tecno",
        "Infinix",
        "Nokia",
        "Other"
    ];

    const laptopBrands = [
        "Dell",
        "HP",
        "Lenovo",
        "Apple",
        "Asus",
        "Acer",
        "MSI",
        "Microsoft",
        "Other"
    ];

    const brandSelect = document.getElementById("brandSelect");
    const phoneRadio = document.getElementById("devicePhone");
    const laptopRadio = document.getElementById("deviceLaptop");

    function loadBrands(brands) {
        brandSelect.innerHTML = '<option value="">Select brand</option>';
        brands.forEach(brand => {
            const option = document.createElement("option");
            option.value = brand;
            option.textContent = brand;
            brandSelect.appendChild(option);
        });
    }

    // Initial load (phone is default)
    loadBrands(phoneBrands);

    phoneRadio.addEventListener("change", () => {
        if (phoneRadio.checked) {
            loadBrands(phoneBrands);
        }
    });

    laptopRadio.addEventListener("change", () => {
        if (laptopRadio.checked) {
            loadBrands(laptopBrands);
        }
    });

    //Image part
    const imageInput = document.querySelector('input[name="DeviceImages"]');
    const previewContainer = document.getElementById("imagePreview");

    imageInput.addEventListener("change", function () {
        previewContainer.innerHTML = "";

        const files = Array.from(this.files);

        if (files.length > 0) {
            // Add a header to the preview section
            const previewHeader = document.createElement("div");
            previewHeader.className = "w-100 mb-2";
            previewHeader.innerHTML = '<small class="text-muted fw-semibold"><i class="bi bi-images me-1"></i>Selected Images (' + files.length + ')</small>';
            previewContainer.appendChild(previewHeader);
        }

        files.forEach((file, index) => {
            if (!file.type.startsWith("image/")) return;

            const wrapper = document.createElement("div");
            wrapper.className = "position-relative";

            const img = document.createElement("img");
            img.src = URL.createObjectURL(file);
            img.className = "img-thumbnail border-2";
            img.style.width = "120px";
            img.style.height = "120px";
            img.style.objectFit = "cover";

            // Add image number badge
            const badge = document.createElement("span");
            badge.className = "position-absolute top-0 start-0 badge bg-primary m-1";
            badge.textContent = index + 1;

            wrapper.appendChild(img);
            wrapper.appendChild(badge);
            previewContainer.appendChild(wrapper);
        });
    });
</script>




