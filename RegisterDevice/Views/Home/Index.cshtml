@model List<RegisterDevice.Models.RegisteredDevice>

@{
    // Layout = "~/Views/Shared/_DeviceLayout.cshtml";
    ViewData["Title"] = "My Devices";

}

@functions {
    string MaskIdentifier(string identifier)
    {
        if (string.IsNullOrEmpty(identifier) || identifier.Length < 8)
            return identifier;

        var first = identifier.Substring(0, 4);
        var last = identifier.Substring(identifier.Length - 3);
        return $"{first}****{last}";
    }
}



@section Styles {
    <style>
        .dashboard-page {
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            background-color: #ffffff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
        }

            .sidebar .nav-link {
                color: #495057;
                padding: 0.875rem 1.25rem;
                border-left: 3px solid transparent;
            }

                .sidebar .nav-link.active {
                    color: #0d6efd;
                    background-color: #e7f1ff;
                    border-left-color: #0d6efd;
                }

        .main-content {
            padding: 2rem;
        }

        .status-badge {
            font-size: 0.75rem;
        }

        @@media (max-width: 767.98px) {
            .main-content {
                width: 100% !important;
                margin: 0 !important;
                padding-top: 1rem !important;
            }
        }


        @@media (max-width: 767.98px) {
            .main-content {
                padding: 1rem;
            }
        }

        @@media (max-width: 767.98px) {
            .layout-wrapper,
            .container-fluid {
                min-height: auto !important;
            }
        }

    </style>
}

<div class="dashboard-page container-fluid">
    <div class="row">

        <!-- Sidebar / Offcanvas -->
        <div class="offcanvas-md offcanvas-start sidebar col-md-3 col-lg-2 px-0"
             tabindex="-1"
             id="sidebarMenu">

            <div class="offcanvas-header d-md-none border-bottom">
                <h5 class="offcanvas-title">Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu"></button>
            </div>

            <nav class="nav flex-column pt-3">
                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-laptop me-2"></i>My Devices
                </a>

                <a class="nav-link" asp-controller="Home" asp-action="RegisterDevice">
                    <i class="bi bi-plus-circle me-2"></i>Register Device
                </a>

                <a class="nav-link" asp-controller="Home" asp-action="Profile">
                    <i class="bi bi-person"></i>Profile
                </a>
            </nav>
        </div>


        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 main-content">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-md-none"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#sidebarMenu">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1 class="h3 mb-0 fw-bold">
                        <i class="bi bi-laptop me-2 text-primary"></i>My Devices
                    </h1>
                </div>
                <a asp-action="RegisterDevice" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-2"></i>Register New Device
                </a>
            </div>

            <!-- Stats Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                                <i class="bi bi-phone-fill text-primary fs-5"></i>
                            </div>
                            <h4 class="fw-bold mb-0">@Model.Count</h4>
                            <small class="text-muted">Total Devices</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            </div>
                            <h4 class="fw-bold mb-0">@Model.Count(d => d.Status == "Active")</h4>
                            <small class="text-muted">Active</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            </div>
                            <h4 class="fw-bold mb-0 text-danger">@Model.Count(d => d.Status == "Lost")</h4>
                            <small class="text-muted">Lost</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Devices Table -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul me-2"></i>Registered Devices
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        @if (Model.Any())
                        {
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 ps-4 fw-semibold text-muted">Device Type</th>
                                        <th class="border-0 fw-semibold text-muted">Brand</th>
                                        <th class="border-0 fw-semibold text-muted">Model</th>
                                        <th class="border-0 fw-semibold text-muted">IMEI</th>
                                        <th class="border-0 fw-semibold text-muted">Status</th>
                                        <th class="border-0 pe-4 fw-semibold text-muted">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var device in Model)
                                    {
                                        var image = device.DeviceImages?.FirstOrDefault()?.ImagePath;

                                        <tr>
                                            <!-- Device Type -->
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                                                        <i class="bi @(device.DeviceType == "Phone" ? "bi-phone text-primary" : "bi-laptop text-info")"></i>
                                                    </div>
                                                    <span class="fw-semibold">@device.DeviceType</span>
                                                </div>
                                            </td>

                                            <!-- Brand -->
                                            <td>
                                                <span class="text-dark">@device.Brand</span>
                                            </td>

                                            <!-- Model -->
                                            <td class="text-muted">@device.Model</td>

                                            <!-- Identifier -->
                                            <td>
                                                <code class="bg-light px-2 py-1 rounded text-dark">@MaskIdentifier(device.Identifier)</code>
                                            </td>

                                            <!-- Status -->
                                            <td>
                                                @if (device.Status == "Lost")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger">
                                                        <i class="bi bi-exclamation-circle-fill me-1"></i>Lost
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                                    </span>
                                                }
                                            </td>

                                            <!-- Actions -->
                                            <td class="pe-4">
                                                <div class="d-flex gap-1">
                                                    <a asp-action="DeviceDetails"
                                                       asp-route-id="@device.Id"
                                                       class="btn btn-sm btn-outline-secondary"
                                                       title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <a asp-action="EditDevice"
                                                       asp-route-id="@device.Id"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="Edit Device">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    @if (device.Status == "Active")
                                                    {
                                                        <button type="button"
                                                                title="Mark as Lost"
                                                                class="btn btn-sm btn-outline-danger"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#markLostModal"
                                                                data-device-id="@device.Id">
                                                            <i class="bi bi-exclamation-triangle"></i>
                                                        </button>
                                                    }
                                                    else if (device.Status == "Lost")
                                                    {
                                                        <button type="button"
                                                                title="Mark as Found"
                                                                class="btn btn-sm btn-outline-success"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#markFoundModal"
                                                                data-device-id="@device.Id">
                                                            <i class="bi bi-check-circle"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                    <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
                                </div>
                                <h5 class="text-muted">No devices registered yet</h5>
                                <p class="text-muted mb-3">Get started by registering your first device</p>
                                <a asp-action="RegisterDevice" class="btn btn-primary">
                                    <i class="bi bi-plus-lg me-2"></i>Register Your First Device
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Info Alert -->
            <div class="alert alert-info border-0 mt-4 d-flex align-items-start shadow-sm" role="alert">
                <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                    <i class="bi bi-info-circle-fill text-info"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">How it works</h6>
                    <p class="mb-0 small">Your registered devices are protected. If a device is lost or stolen, mark it as "Lost" and it will appear in public searches as reported.</p>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal to mark the device as Lost -->
<div class="modal fade" id="markLostModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    Mark Device as Lost
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center py-4">
                <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                </div>
                <p class="mb-2">
                    Are you sure you want to mark this device as <strong class="text-danger">LOST</strong>?
                </p>
                <small class="text-muted">
                    This will make the device publicly searchable and visible to others.
                </small>
            </div>

            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>

                <form asp-action="MarkLost" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="lostDeviceId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>Yes, Mark as Lost
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal to mark the device as Found -->
<div class="modal fade" id="markFoundModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    Mark Device as Found
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center py-4">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-check-circle-fill text-success fs-1"></i>
                </div>
                <p class="mb-2">
                    Has this device been <strong class="text-success">FOUND</strong>?
                </p>
                <small class="text-muted">
                    This will remove it from public lost searches and mark it as active.
                </small>
            </div>

            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>

                <form asp-action="MarkFound" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="foundDeviceId" />
                    <button type="submit"
                            class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Yes, Mark as Found
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript for modal device ID handling -->
<script>
    const markLostModal = document.getElementById('markLostModal');
    const markFoundModal = document.getElementById('markFoundModal');

    markLostModal?.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        document.getElementById('lostDeviceId').value =
            button.getAttribute('data-device-id');
    });

    markFoundModal?.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        document.getElementById('foundDeviceId').value =
            button.getAttribute('data-device-id');
    });
</script>






