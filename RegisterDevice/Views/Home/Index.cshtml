            <div class="modal-footer justify-content-center">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="MarkFound" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="foundDeviceId" />
