@model ProfileViewModel

<div class="container py-4">
    <nav class="nav flex-column pt-3">
        <a class="nav-link active" asp-controller="Home" asp-action="Index">
            <i class="bi bi-arrow-left me-2"></i>Back to My Devices
        </a>
    </nav>

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-person-circle text-primary me-2"></i>
            My Profile
        </h2>
        <p class="text-muted mb-0">View and manage your account information</p>
    </div>

    <div class="row g-4">


        <!-- PROFILE CARD -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <!-- Profile Avatar -->
                    <div class="rounded-circle bg-primary bg-gradient text-white d-inline-flex align-items-center justify-content-center mb-3 shadow"
                         style="width:100px;height:100px;font-size:40px;font-weight:bold;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>

                    <!-- User Info -->
                    <h4 class="fw-bold mb-2">@Model.FullName</h4>

                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-center text-muted mb-2">
                            <i class="bi bi-envelope-fill me-2"></i>
                            <span>@Model.Email</span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div class="d-flex align-items-center justify-content-center text-muted">
                                <i class="bi bi-telephone-fill me-2"></i>
                                <span>@Model.PhoneNumber</span>
                            </div>
                        }
                    </div>

                    <!-- Account Status Badge -->
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i>Active Account
                    </span>
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                        Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-laptop me-2"></i>View My Devices
                        </a>
                        <a asp-controller="Home" asp-action="RegisterDevice" class="btn btn-outline-primary">
                            <i class="bi bi-plus-circle me-2"></i>Register New Device
                        </a>
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">
                            <i class="bi bi-shield-lock me-2"></i>Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-lg-8">

            <!-- STATS CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        Total Devices
                                    </p>
                                    <h2 class="fw-bold mb-0">@Model.TotalDevices</h2>
                                </div>
                                <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-phone-fill text-primary fs-4"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-shield-check me-1"></i>
                                    <span class="fw-semibold">Registered & Protected</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        Lost Devices
                                    </p>
                                    <h2 class="fw-bold mb-0 text-danger">@Model.LostDevices</h2>
                                </div>
                                <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-danger">
                                    <i class="bi bi-search me-1"></i>
                                    <span class="fw-semibold">Publicly Searchable</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        Active Devices
                                    </p>
                                    <h2 class="fw-bold mb-0 text-success">@(Model.TotalDevices - Model.LostDevices)</h2>
                                </div>
                                <div class="bg-success bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-success">
                                    <i class="bi bi-shield-fill-check me-1"></i>
                                    <span class="fw-semibold">Safe & Secure</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p class="text-muted text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        Account Status
                                    </p>
                                    <h5 class="fw-bold mb-0 text-success">Verified</h5>
                                </div>
                                <div class="bg-info bg-opacity-10 rounded-3 p-3">
                                    <i class="bi bi-patch-check-fill text-info fs-4"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    <span class="fw-semibold">Member since @DateTime.Now.Year</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCOUNT INFORMATION -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 pt-4">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>
                        Account Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-person me-1"></i>Full Name
                                </small>
                                <span class="fw-semibold">@Model.FullName</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-envelope me-1"></i>Email Address
                                </small>
                                <span class="fw-semibold">@Model.Email</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-telephone me-1"></i>Phone Number
                                </small>
                                <span class="fw-semibold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-shield-check me-1"></i>Account Type
                                </small>
                                <span class="fw-semibold">Standard User</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECURITY & SETTINGS -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-gear-fill text-primary me-2"></i>
                        Security & Settings
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-0">
                            <div>
                                <i class="bi bi-key-fill text-primary me-2"></i>
                                <span class="fw-semibold">Change Password</span>
                                <br>
                                <small class="text-muted">Update your account password</small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>

                        <a asp-controller="Account" asp-action="EditProfile" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-0">
                            <div>
                                <i class="bi bi-pencil-square text-primary me-2"></i>
                                <span class="fw-semibold">Edit Profile</span>
                                <br>
                                <small class="text-muted">Update your personal information</small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>

                        <a asp-controller="Account" asp-action="Privacy" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 px-0">
                            <div>
                                <i class="bi bi-shield-lock-fill text-primary me-2"></i>
                                <span class="fw-semibold">Privacy Settings</span>
                                <br>
                                <small class="text-muted">Manage your privacy preferences</small>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- HELP SECTION -->
    <div class="alert alert-info border-0 shadow-sm mt-4">
        <div class="d-flex align-items-start">
            <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-question-circle-fill text-info"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1">Need Help?</h6>
                <p class="mb-0 small">If you need to update your email address or have any issues with your account, please contact our support team.</p>
            </div>
        </div>
    </div>

</div>





