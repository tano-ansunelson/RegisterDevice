@model ProfileViewModel

<h2 class="mb-4">My Profile</h2>

<div class="row">
    <!-- PROFILE CARD -->
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body text-center">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:80px;height:80px;font-size:30px;">
                    @Model.FullName.Substring(0, 1)
                </div>

                <h5>@Model.FullName</h5>
                <p class="text-muted">@Model.Email</p>
                <p>@Model.PhoneNumber</p>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h6>Total Registered Devices</h6>
                        <h3>@Model.TotalDevices</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm mb-3 text-danger">
                    <div class="card-body">
                        <h6>Lost Devices</h6>
                        <h3>@Model.LostDevices</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="card shadow-sm">
            <div class="card-body">
                <a asp-controller="MyDevices" asp-action="Index" class="btn btn-primary me-2">
                    My Devices
                </a>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">
                    Change Password
                </a>
            </div>
        </div>
    </div>
</div>
